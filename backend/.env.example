# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接地址
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edu_management?schema=public"

# ==================== JWT 配置 ====================
# JWT 密钥（生产环境请使用复杂的随机字符串）
JWT_SECRET="your-jwt-secret-key-change-in-production"

# JWT 过期时间
JWT_EXPIRATION="2h"

# JWT 刷新令牌过期时间
JWT_REFRESH_EXPIRATION="7d"

# ==================== 应用配置 ====================
# 应用运行端口
PORT=3000

# 应用运行环境
NODE_ENV="development"

# ==================== 文件上传配置 ====================
# 文件上传目录
UPLOAD_DIR="./uploads"

# 最大文件大小（字节）
MAX_FILE_SIZE=10485760

# ==================== CORS 配置 ====================
# 允许的前端地址（逗号分隔）
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# ==================== WebSocket 配置 ====================
# WebSocket 命名空间
WS_NAMESPACE="/notifications"

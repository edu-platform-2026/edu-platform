{
  "version": 2,
  "installCommand": "npm install && npx prisma generate && npx nest build",
  "builds": [
    {
      "src": "dist/vercel.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**/*.js",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "dist/vercel.js" }
  ]
}
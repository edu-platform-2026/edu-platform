# Database
DATABASE_URL="postgresql://edu_user:edu_password_2026@localhost:5432/edu_platform"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-2026"
JWT_EXPIRATION="2h"
JWT_REFRESH_EXPIRATION="7d"

# MinIO
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="edu-platform"
MINIO_USE_SSL=false

# App
NODE_ENV="development"
PORT=3000
API_PREFIX="api/v1"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10